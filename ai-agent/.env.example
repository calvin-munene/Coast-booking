# Required for AI responses. Create at https://build.nvidia.com/ and keep it server-side.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
# Optional comma-separated allowlist shown in the browser model selector.
NVIDIA_MODELS=meta/llama-3.3-70b-instruct,nvidia/llama-3.3-nemotron-super-49b-v1.5,meta/llama-3.1-70b-instruct,meta/llama-3.1-8b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_GLOBAL_REQUESTS_PER_HOUR=300
NVIDIA_MAX_CONCURRENT_REQUESTS=4
NVIDIA_CIRCUIT_FAILURE_THRESHOLD=5
NVIDIA_CIRCUIT_COOLDOWN_SECONDS=60

# Customize the assistant
SYSTEM_PROMPT=You are a helpful, concise AI assistant.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
DEPLOYMENT_VERSION=development

# Telegram: create a bot with @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret
TELEGRAM_ADMIN_USER_ID=
TELEGRAM_STARS_REQUIRED=true
TELEGRAM_STAR_SIGNING_SECRET=
TELEGRAM_WEBAPP_MAX_AGE_SECONDS=300
TELEGRAM_WEBAPP_SESSION_TTL_SECONDS=3600
# Optional secure Telegram website login. Configure all three together in BotFather.
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URI=https://nvidbot.onrender.com/auth/telegram/callback
WEB_SESSION_IDLE_SECONDS=1800
WEB_SESSION_ABSOLUTE_SECONDS=43200
DATABASE_URL=
# Optional comma-separated numeric user IDs for a private/personal bot.
TELEGRAM_ALLOWED_USER_IDS=
PUBLIC_URL=https://nvidbot.onrender.com
# Trust exactly the rightmost forwarding entry added by Render. Leave empty outside Render.
TRUST_PROXY=render

# Required before Bot Management can store encrypted credentials. Use a base64-encoded random 32-byte key.
BOT_CREDENTIAL_ENCRYPTION_KEY=
BOT_CREDENTIAL_KEY_VERSION=v1

# WhatsApp Cloud API: Meta developer app credentials
# AI replies remain disabled until the database feature flag whatsapp_ai is explicitly enabled.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-verify-token
META_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0
