# Required for AI responses. Create at https://build.nvidia.com/
NVIDIA_API_KEY=nvapi-your-key
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Customize the assistant
SYSTEM_PROMPT=You are a helpful, concise AI assistant.
PORT=3000

# Telegram: create a bot with @BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret

# WhatsApp Cloud API: Meta developer app credentials
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-verify-token
META_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0
